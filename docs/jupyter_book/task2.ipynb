    "# Minh họa thực thi: Gọi Parser Service trích xuất CPG từ 1 file nguồn Python\n",
    "import sys\n",
    "import json\n",
    "sys.path.append('../../src/parser')\n",
    "from cpg_parser import parse_python_file\n",
    "\n",
    "target_file = 'src/parser/cpg_parser.py'\n",
    "metadata, nodes, edges, error = parse_python_file(target_file, repo_root='.')\n",
    "\n",
    "print('==================================================')\n",
    "print(' Demonstrating Incremental CPG Parser Service')\n",
    "print(f' Target File: {target_file}')\n",
    "print('==================================================')\n",
    "print('METADATA EVENT:')\n",
    "print(json.dumps(metadata, indent=2))\n",
    "print(f'\\nTotal AST Nodes Extracted: {len(nodes)}')\n",
    "print(f'Total Graph Edges Extracted: {len(edges)}')\n",
    "print('\\nSAMPLE NODE EVENT:')\n",
    "print(json.dumps(nodes[0], indent=2))\n",
    "print('\\nSAMPLE EDGE EVENT:')\n",
    "print(json.dumps(edges[0], indent=2))\n"
   ]
